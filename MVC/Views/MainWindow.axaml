<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="clr-namespace:MVC.ViewModels"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:view="clr-namespace:MVC.Views"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="800"
		x:Class="MVC.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		x:CompileBindings="False"
		Background="#1F232A"
		Icon="/Assets/avalonia-logo.ico"
		Title="MVC"
		MinWidth="700"
		MinHeight="600"
		Width="800"
		Height="800">

    <Grid Margin="8">
        <TabControl Padding="0,4,4,4">
            <TabItem Header="Vidéo" HorizontalAlignment="Stretch" CornerRadius="6" MinWidth="100">
                <view:VideoView DataContext="{Binding Video}"/>
            </TabItem>
            <TabItem Header="Playlist" HorizontalAlignment="Stretch" CornerRadius="6" MinWidth="100">
                <view:PlaylistView DataContext="{Binding Playlist}"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>